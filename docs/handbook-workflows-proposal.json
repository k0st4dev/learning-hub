  "sourceGuides": [
    {
      "key": "guide-appendix-b",
      "route": "/course/software-engineer/guide/appendix-b",
      "sourceContent": [
        {
          "sourceId": "p2229",
          "style": "Heading1",
          "text": "Appendix B — Git standard",
          "textSha256": "569cb22af5a26bc0e0690f9e3c08074caad70de1bc4c76078216a7d2895f9bf6",
          "websiteLocation": "/course/software-engineer/guide/appendix-b"
        },
        {
          "sourceId": "p2230",
          "style": "ListBullet",
          "text": "Jedan repo programming-gym može sadržati manje vežbe; veći projekti mogu biti zasebni repozitorijumi.",
          "textSha256": "1abb5a9d15e6030f8c6b93e50855f5224b6ce703de9db2770b0f1af0b9f20cc3",
          "websiteLocation": "/course/software-engineer/guide/appendix-b"
        },
        {
          "sourceId": "p2231",
          "style": "ListBullet",
          "text": "Commit kada napraviš smislenu jedinicu: “add validation”, “implement winner detection”, “add API error handler” — ne “stuff”.",
          "textSha256": "3d38e214c12a5789fe97c71845fc919d7924c82f204908927c89ca2f27da1910",
          "websiteLocation": "/course/software-engineer/guide/appendix-b"
        },
        {
          "sourceId": "p2232",
          "style": "ListBullet",
          "text": "Pre svakog commit-a: pokreni program/testove, pročitaj git diff, ukloni secrets/debug noise.",
          "textSha256": "bf5d7e3e80a58bf89b73e489e421b19186c0c7f1ddaed2625b9b00e56c16bc15",
          "websiteLocation": "/course/software-engineer/guide/appendix-b"
        },
        {
          "sourceId": "p2233",
          "style": "ListBullet",
          "text": "Za svaki veći projekat README mora odgovoriti: šta radi, kako se pokreće, arhitektura, glavne odluke, known limitations.",
          "textSha256": "da541dccd94546849cab4f20a24a95b4048a18816e0abdf3df7b357ca6e86785",
          "websiteLocation": "/course/software-engineer/guide/appendix-b"
        },
        {
          "sourceId": "p2234",
          "style": "ListBullet",
          "text": "Jednom nedeljno pogledaj git log: cilj nije broj commitova nego vidljiv razvoj rešenja.",
          "textSha256": "92ab1bb939152e353119c510d3963c241a0c0185d3b968dfbc65bfbbe71ce8df",
          "websiteLocation": "/course/software-engineer/guide/appendix-b"
        }
      ],
      "proposedInterpretation": {
        "status": "pending-user-approval",
        "tool": "temporary-git-review",
        "controlSourceIds": ["p2231", "p2232", "p2233", "p2234"],
        "storage": "none",
        "courseCredit": false,
        "conditions": {
          "informationalSourceIds": ["p2230"],
          "conditionalLargerProjectSourceId": "p2233",
          "weeklyGuidanceSourceId": "p2234",
          "compoundPreCommitSourceId": "p2232"
        }
      }
    },
    {
      "key": "guide-appendix-c",
      "route": "/course/software-engineer/guide/appendix-c",
      "sourceContent": [
        {
          "sourceId": "p2235",
          "style": "Heading1",
          "text": "Appendix C — definicija “znam koncept”",
          "textSha256": "cc045a70fa12c942036766ab9ac4066c4102343d702d545c8b83d73bc7212c6e",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        },
        {
          "sourceId": "p2236",
          "style": "ListBullet",
          "text": "Mogu da ga objasnim bez definicije napamet.",
          "textSha256": "9131239bd8c3d152c569da2060b17f0e010153822a23f3b206a45dccdae922f0",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        },
        {
          "sourceId": "p2237",
          "style": "ListBullet",
          "text": "Mogu da napišem mali primer bez gledanja.",
          "textSha256": "ae0ab0315a0c5574b75a0e021bc69eeeaf358c65376574867f69fc6c103dd8d2",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        },
        {
          "sourceId": "p2238",
          "style": "ListBullet",
          "text": "Mogu da prepoznam kada mi treba u nepoznatom problemu.",
          "textSha256": "4b7009f4b91a3f322a7cfcfe57c871a0cece98c0911b8bcb83f4ee7891ef088c",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        },
        {
          "sourceId": "p2239",
          "style": "ListBullet",
          "text": "Mogu da debugujem tipičnu grešku vezanu za njega.",
          "textSha256": "acd3826885002e8def2218fb3c849c7f472bc3870ae908bf6b938ddab4f15d34",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        },
        {
          "sourceId": "p2240",
          "style": "ListBullet",
          "text": "Mogu da navedem barem jedan trade-off/ograničenje.",
          "textSha256": "b8c7a7077f709f332f37fc48e2bc80be13c447a49a5df0bfdf49d26d88ae30a9",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        },
        {
          "sourceId": "p2241",
          "style": "ListBullet",
          "text": "Mogu da pročitam tuđ kod koji ga koristi.",
          "textSha256": "0106da562c7464c6ad07507d3d4dc03af7739d57d125b070638bebbedec5458e",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        },
        {
          "sourceId": "p2242",
          "style": "ListBullet",
          "text": "Ako AI napiše implementaciju, mogu da je proverim i objasnim red po red.",
          "textSha256": "d50173cc29ca9cc849c1939782f0e70df38e0c1ca7aaa703d55d458ea31706f0",
          "websiteLocation": "/course/software-engineer/guide/appendix-c"
        }
      ],
      "proposedInterpretation": {
        "status": "pending-user-approval",
        "tool": "temporary-concept-review",
        "controlSourceIds": [
          "p2236",
          "p2237",
