        }
      }
    },
    {
      "key": "guide-appendix-g",
      "route": "/course/software-engineer/guide/appendix-g",
      "sourceContent": [
        {
          "sourceId": "p2350",
          "style": "Heading1",
          "text": "Appendix G — posle 28.02.2027: sledeća odluka",
          "textSha256": "99a3260d37f42656bcaba6d02db7c2868a8f3813d61473ba5a0a8b8f30194843",
          "websiteLocation": "/course/software-engineer/guide/appendix-g"
        },
        {
          "sourceId": "p2351",
          "style": "ListBullet",
          "text": "Ako želiš web/backend: nastavi Full Stack Open Part 6–7, zatim TypeScript/containers/relational DB delove koji odgovaraju cilju.",
          "textSha256": "f74a3b0222f2199c2637a433a05a501c3324fd24fb3e328514809a488a1ba791",
          "websiteLocation": "/course/software-engineer/guide/appendix-g"
        },
        {
          "sourceId": "p2352",
          "style": "ListBullet",
          "text": "Ako želiš jači CS/algorithms: završi preostale Odin data-structure projekte i radi strukturisan DS&A program; LeetCode koristi kao trening, ne kao curriculum.",
          "textSha256": "320ed61b4b29506865ab0621a64720887e74ac475d752069e1a75784101127b9",
          "websiteLocation": "/course/software-engineer/guide/appendix-g"
        },
        {
          "sourceId": "p2353",
          "style": "ListBullet",
          "text": "Ako želiš systems: produbi C, operating systems, networking i computer architecture.",
          "textSha256": "df6f80ecfa460dc7029b69066481f735c1928e391a46c7059ad3b89b131bdf9d",
          "websiteLocation": "/course/software-engineer/guide/appendix-g"
        },
        {
          "sourceId": "p2354",
          "style": "ListBullet",
          "text": "Ako želiš profesionalni portfolio: napravi još 2 capstone projekta sa različitim problemima, bez build-along tutorijala.",
          "textSha256": "42fcb2241cd53c61f97699c83306b8693b698b337e3e9ac252f1d15c13ba7927",
          "websiteLocation": "/course/software-engineer/guide/appendix-g"
        },
        {
          "sourceId": "p2355",
          "style": "ListBullet",
          "text": "U svakoj grani zadrži isti loop: spec → plan → implementacija → tests → review → rewrite/transfer.",
          "textSha256": "ef49b1c58c545c1dbb99064a7592ed4cc7d647633c4c2aacf823e702314fe3d6",
          "websiteLocation": "/course/software-engineer/guide/appendix-g"
        }
      ],
      "proposedInterpretation": {
