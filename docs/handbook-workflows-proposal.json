        }
      }
    }
  ],
  "supportingSource": [
    {
      "sourceId": "p0054",
      "style": "Normal",
      "text": "Pravilo 20/30 minuta\nZa mali problem pokušavaj minimum 20 min; za ozbiljniji algoritam/projekatski bug 30 min. Pre AI-a moraš imati zapis šta si pokušao, šta očekuješ i gde tačno puca.",
      "textSha256": "8e6656fda729e555e2aee6935f408a543c80629f1a3d4e62871c74444c7ed12d",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    },
    {
      "sourceId": "p0062",
      "style": "Heading2",
      "text": "Hint ladder",
      "textSha256": "1ca77249e3603753deaf6b5ec935a61730a0e90e227e67b01cb66cf07d95cca2",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    },
    {
      "sourceId": "p0063",
      "style": "ListBullet",
      "text": "Level 0: nema pomoći.",
      "textSha256": "a4edd7610ed74e75f2d67195a5f8e32c208a8a38e05900c92f4e66d303145457",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    },
    {
      "sourceId": "p0064",
      "style": "ListBullet",
      "text": "Level 1: AI postavlja jedno pitanje koje te usmerava.",
      "textSha256": "4dbfc5fcb72f2b48b4d84fede8ffc7c54e58a686d6e661ed4fb2cabe47692d69",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    },
    {
      "sourceId": "p0065",
      "style": "ListBullet",
      "text": "Level 2: mali konceptualni hint.",
      "textSha256": "ec368e903db285a650435af06d9f976ac7bc76f7b74500139e47159933379496",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    },
    {
      "sourceId": "p0066",
      "style": "ListBullet",
      "text": "Level 3: kaže koji koncept/strukturu da razmotriš.",
      "textSha256": "72c6161ba83be34c827af87185fe229201d344feee5dcc0c994222ba4028d47d",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    },
    {
      "sourceId": "p0067",
      "style": "ListBullet",
      "text": "Level 4: pseudocode bez koda.",
      "textSha256": "dc75b62fc6513abb40685a3ff89b90d5157eb2d27bf5032ab089f0f60114bfdc",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    },
    {
      "sourceId": "p0068",
      "style": "ListBullet",
      "text": "Level 5: solution — samo ako si iscrpeo prethodne nivoe; zatim zatvori solution i napiši ponovo od nule.",
      "textSha256": "0dd31b7e50e6bc014462eef6dd17498f841cb79329e6a669796ae127649ddd11",
      "websiteLocation": "/course/software-engineer/guide/ai-protocol"
    }
  ],
